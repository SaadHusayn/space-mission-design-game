{
  "name": "mission-architect",
  "version": "0.1.0",
  "private": true,
  "description": "3D space mission design game by Team The Astranauts for NASA Space Apps Challenge 2026.",
  "siDisclosure": "Super Intelligence (SI) tools assisted in TypeScript/React/R3F code scaffolding, JSON mission data structuring, and procedural Web Audio synthesis (src/audio/soundEngine.ts). No SI-generated images/videos or NASA branding used.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:textures": "node scripts/import-textures.mjs",
    "assets:models": "node scripts/build-placeholder-models.mjs && node scripts/optimize-assets.mjs",
    "test:e2e": "next build && playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "immer": "^11.2.10",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
